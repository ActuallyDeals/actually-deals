NEXT_PUBLIC_SITE_URL=https://actuallydeals.com

# Persistence — leave blank to use the local file/memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin. Empty or missing locks the desk (no default password).
ADMIN_PASSWORD=

# Affiliate tags. Empty non-Amazon IDs = clean retailer URL (no wrap). Never invent IDs.
# Amazon Associates is live — one Store ID only. Do not use actuallydeals-20.
AFFILIATE_AMAZON_TAG=actuallydea07-20
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=actuallydea07-20

# Impact: Walmart / Target / Home Depot / Best Buy / Kohl's. Empty AFFILIATE_*_ID = no wrap.
AFFILIATE_WALMART_ID=
NEXT_PUBLIC_WALMART_AFFILIATE_URL=
AFFILIATE_TARGET_ID=
NEXT_PUBLIC_TARGET_AFFILIATE_URL=
AFFILIATE_HOMEDEPOT_ID=
NEXT_PUBLIC_HOME_DEPOT_AFFILIATE_URL=
AFFILIATE_BESTBUY_ID=
NEXT_PUBLIC_BEST_BUY_AFFILIATE_URL=
AFFILIATE_KOHLS_ID=

# CJ: PID 8059705 is our known publisher ID (prefer env). Dick's advertiser 7345657 is
# known from the CJ advertiser page (not joined yet; wrap still emits). Office Depot AID when known.
# Booking.com / Expedia / Hotels.com: set AID after the CJ account is applied. Empty AID = clean retailer URL, no wrap. Do not invent advertiser IDs.
AFFILIATE_CJ_PID=
AFFILIATE_CJ_DICKS_AID=
AFFILIATE_CJ_OFFICE_DEPOT_AID=
AFFILIATE_CJ_BOOKING_AID=
AFFILIATE_CJ_EXPEDIA_AID=
AFFILIATE_CJ_HOTELS_AID=

# eBay Partner Network. No campid = no wrap. Rover params: mkcid=1, mkrid=711-53200-19255-0, toolid=10001, mkevt=1.
AFFILIATE_EBAY_CAMPAIGN_ID=

# Newegg via Rakuten. SID 4745711 is remembered (prefer env). MID when known. Both required to wrap.
AFFILIATE_RAKUTEN_SID=
AFFILIATE_NEWEGG_MID=

# Costco: no FlexOffers pattern in repo — skip wrap.

# Social auto-post after Publish. Default off (unset or not "true" is a no-op).
# Official APIs only — do not scrape cookies. Missing keys no-op that network.
SOCIAL_AUTO_POST=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
